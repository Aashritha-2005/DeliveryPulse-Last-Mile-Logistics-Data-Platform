# --- Secrets and credentials (never commit) ---
.env
.env.local
*.pem
*.key
kubeconfig
*.kubeconfig

# --- Generated data: ignore contents, keep the folder skeleton ---
# `data/*` alone would not work: git cannot re-include files inside an
# ignored directory, so directories are re-included first, then .gitkeep.
data/**
!data/**/
!data/**/.gitkeep
*.parquet

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Terraform state ---
# State and plans contain the account ID and resource ARNs; .terraform.lock.hcl is committed.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
*.tfplan
*.tfvars
crash.log

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
