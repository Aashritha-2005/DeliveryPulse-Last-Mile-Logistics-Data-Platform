# DeliveryPulse local configuration template.
# Copy to `.env` (git-ignored) and edit there:  cp .env.example .env
# Secrets below are placeholders; replace every placeholder in .env with a real local value.
# Never put real secrets in this file.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (core profile) ---
# Host port bound on 127.0.0.1 only. Change it if 5432 is already in use.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=deliverypulse

# Bootstrap superuser: used only by the container for initialisation and admin.
# The pipeline and dashboards never connect as this user.
POSTGRES_SUPERUSER=deliverypulse_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# Application role passwords. Applied ONLY when the database volume is first initialised;
# changing them later requires `make reset-db` (see docs/operations.md).
DELIVERYPULSE_ETL_PASSWORD=CHANGE_ME
DELIVERYPULSE_READONLY_PASSWORD=CHANGE_ME

# --- Airflow (airflow profile; see docs/operations.md, "Airflow") ---
# Host user id the Airflow containers run as (`id -u`), so files they write under data/ belong
# to you. 50000 is the image's default user.
AIRFLOW_UID=50000
# Password of Airflow's own metadata database (a separate container, no published port).
AIRFLOW_DB_PASSWORD=CHANGE_ME
# Encrypts connection passwords stored by Airflow: 32 random bytes, URL-safe base64.
AIRFLOW_FERNET_KEY=CHANGE_ME
# Signs the tokens Airflow's components use to talk to its API server.
AIRFLOW_JWT_SECRET=CHANGE_ME

# --- Object store (s3 profile; see docs/operations.md, "Object storage lake") ---
# Local S3-compatible store (SeaweedFS); its S3 API is bound to 127.0.0.1 only.
S3_API_PORT=8333
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_BUCKET=deliverypulse
S3_REGION=us-east-1
# Leave false. Pointing the lake at real AWS S3 needs explicit approval first.
S3_ALLOW_AWS=false
# Admin key: used only by `make s3-up` to create the bucket. Pipeline key: read, write and list
# on S3_BUCKET only. Each key and secret: 16-128 letters and digits (e.g. openssl rand -hex 20).
S3_ADMIN_ACCESS_KEY=CHANGE_ME
S3_ADMIN_SECRET_KEY=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- Kafka (streaming profile only; local synthetic-data demo, no authentication) ---
# Public cluster identifier, not a secret. Keep it unchanged while its volume exists.
# Generate your cluster ID before starting Kafka:
# docker run --rm apache/kafka:4.3.1@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_ORDERS=deliverypulse.orders.v1
KAFKA_TOPIC_PINGS=deliverypulse.driver_pings.v1
KAFKA_TOPIC_DLQ=deliverypulse.events.dlq.v1
